// A squat: no rotation, no flight. The sanity case, because if imitation
// cannot learn this one, nothing acrobatic is worth attempting.
//
// Damping lowered from the standing default of kd = kp/10 to kd = kp/50.
// Tracking bandwidth is kp/kd, and the 2D milestone measured a knee reaching
// 47% of a commanded 3 Hz swing at kp/10 against 97% at kp/50. Nothing about
// three dimensions changes that: the PD preview of this clip at the standing
// gains never leaves the ground at all, peaking at 1.02 m against the 1.62 m
// the reference asks for.
{
  "max_episode_steps": 300,

  "reset_noise": {
    "root_tilt": 0.05,
    "root_height": 0.02,
    "joint_angle": 0.06,
    "linear_velocity": 0.0,
    "angular_velocity": 0.0
  },

  "humanoid": {
    "joints": [
      {"name": "waist",      "kd": 80},
      {"name": "neck",       "kd": 8},
      {"name": "shoulder_l", "kd": 16},
      {"name": "elbow_l",    "kd": 10},
      {"name": "shoulder_r", "kd": 16},
      {"name": "elbow_r",    "kd": 10},
      {"name": "hip_l",      "kd": 80},
      {"name": "knee_l",     "kd": 60},
      {"name": "ankle_l",    "kd": 30},
      {"name": "hip_r",      "kd": 80},
      {"name": "knee_r",     "kd": 60},
      {"name": "ankle_r",    "kd": 30}
    ]
  },

  "imitation": {
    "motion": "motions/squat3d.json",
    "enabled": true,
    "reference_state_init": true,
    "early_termination_pose_error": 1.1,
    "early_termination_root_error": 0.7,
    "end_episode_at_motion_end": true,

    // Falloff rates measured against what the figure actually does, not carried
    // over from 2D.
    //
    // The 2D rates left three of the five terms reading 0.001, 0.002 and 0.007
    // on a policy that completed the clip 32 times out of 32. Inverting
    // exp(-k*E) says why: 0.536 rad of joint error, 7.2 rad/s of joint velocity
    // error and 0.288 m of end-effector error, all far enough out that the
    // exponential is flat there.
    //
    // A flat term is not a weak signal, it is no signal, and this time it was
    // flat *at initialization* rather than at convergence. A term dead at
    // convergence has at least done its job on the way; a term dead at the start
    // can never produce the gradient that would rescue it, so the policy
    // optimised root and centre of mass and ignored pose entirely.
    //
    // These put each term near 0.4 where an untrained policy starts and near
    // 0.87 where a good one should end up, which is the range where the
    // exponential actually discriminates.
    "scales": {
      "pose": 0.27,
      "joint_velocity": 0.0015,
      "end_effector": 2.8,
      "root": 20.0,
      "com": 10.0,
      "root_angle_weight": 0.5
    }
  }
}